{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "hosts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cron": {
      "type": "boolean"
    },
    "telegram_token": {
      "type": "string"
    },
    "telegram_chat_id": {
      "type": "string"
    },
    "telegram_topic_id": {
      "type": "integer"
    }
  },
  "required": ["hosts", "cron"]
}
