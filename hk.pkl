amends "package://github.com/jdx/hk/releases/download/v1.56.1/hk@1.56.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.56.1/hk@1.56.1#/Builtins.pkl"
import "./hk-local.pkl" as Local

local projectLinters = Local.projectLinters
local projectExcludes = Local.exclude

exclude = List(
    "**/pnpm-lock.yaml",
    "**/_not_used/**",
    "**/fixtures/**",
    "**/public/cdn/**",
) + projectExcludes

local linters = (projectLinters) {
    ["biome"] = (Builtins.biome) {
        glob = List(
            "**/*.cjs",
            "**/*.js",
            "**/*.mjs",
            "**/*.json",
            "**/*.jsonc",
            "**/*.jsx",
            "**/*.ts",
            "**/*.tsx",
        )
        condition = "exec('test -x node_modules/.bin/biome && printf true || printf false') == 'true'"
        check = "node_modules/.bin/biome check --error-on-warnings --unsafe --no-errors-on-unmatched {{ files }}"
        fix = "node_modules/.bin/biome check --write --error-on-warnings --unsafe --no-errors-on-unmatched {{ files }}"
    }

    ["prettier"] {
        batch = true
        glob = List(
            "**/*.md",
            "**/*.mdx",
            "**/*.json5",
            "**/*.yaml",
            "**/*.yml",
            "**/*.html",
            "**/*.astro",
            "**/*.css",
            "**/*.scss",
        )
        condition = "exec('test -x node_modules/.bin/prettier && printf true || printf false') == 'true'"
        check = "node_modules/.bin/prettier --no-error-on-unmatched-pattern --check {{ files }}"
        fix = "node_modules/.bin/prettier --no-error-on-unmatched-pattern --write {{ files }}"
    }

    ["oxlint"] {
        glob = List("**/*.ts", "**/*.tsx")
        depends = "biome"
        condition = "exec('test -x node_modules/.bin/oxlint && printf true || printf false') == 'true'"
        check = "node_modules/.bin/oxlint --deny-warnings --report-unused-disable-directives --no-error-on-unmatched-pattern {{ files }}"
        fix = "node_modules/.bin/oxlint --fix --deny-warnings --report-unused-disable-directives --no-error-on-unmatched-pattern {{ files }}"
    }

    ["ruff"] = (Builtins.ruff) {
        condition = "exec('test -x .venv/bin/ruff && printf true || printf false') == 'true'"
        check = ".venv/bin/ruff check --force-exclude {{ files }}"
        fix = ".venv/bin/ruff check --force-exclude --fix {{ files }}"
    }

    ["ruff-format"] = (Builtins.ruff_format) {
        depends = "ruff"
        condition = "exec('test -x .venv/bin/ruff && printf true || printf false') == 'true'"
        check_diff = ".venv/bin/ruff format --quiet --force-exclude --diff {{ files }}"
        fix = ".venv/bin/ruff format --quiet --force-exclude {{ files }}"
    }

    ["basedpyright"] {
        glob = List("**/*.py", "**/*.pyi", "pyrightconfig.json")
        depends = "ruff-format"
        condition = "exec('test -x .venv/bin/basedpyright && printf true || printf false') == 'true'"
        check = "uv run basedpyright"
    }

    ["swift-format"] {
        glob = "**/*.swift"
        check = "xcrun swift-format lint --strict --parallel {{ files }}"
        fix = "xcrun swift-format format --in-place --parallel {{ files }}"
    }

    ["swiftlint"] = (Builtins.swiftlint) {
        depends = "swift-format"
        check = "swiftlint lint --strict --quiet --force-exclude {{ files }}"
        fix = "swiftlint lint --fix --quiet --force-exclude {{ files }} && swiftlint lint --strict --quiet --force-exclude {{ files }}"
    }

    ["nginxfmt"] {
        glob = List(
            "**/nginx/*.conf",
            "**/templates/nginx*.conf",
        )
        condition = "exec('test -x .venv/bin/nginxfmt && printf true || printf false') == 'true'"
        fix = ".venv/bin/nginxfmt -v {{ files }}"
    }

    ["taplo-format"] = Builtins.taplo_format

    ["check-case-conflict"] = Builtins.check_case_conflict
    ["fix-byte-order-marker"] = Builtins.byte_order_marker
    ["check-symlinks"] = Builtins.check_symlinks
    ["mixed-line-ending"] = Builtins.mixed_line_ending
    ["trailing-whitespace"] = Builtins.trailing_whitespace
}

local checkLinters = (linters) {
    ["oxlint"] {
        depends = List()
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stage = true
        stash = "patch-file"
        steps = linters
    }

    ["fix"] {
        fix = true
        stage = false
        steps = linters
    }

    ["check"] {
        fix = false
        steps = checkLinters
    }
}
